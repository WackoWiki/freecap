{
	"name" : "wackowiki/freecap",
	"description" : "freeCap CAPTCHA library",
	"type" : "library",
	"license" : "GPL-2.0-or-later",
	"minimum-stability" : "stable",
	"support" : {
		"issues" : "https://github.com/WackoWiki/freecap/issues",
		"source" : "https://github.com/WackoWiki/freecap"
	},
	"require" : {
		"php" : ">=8.2",
		"ext-gd" : "*"
	},
	"require-dev" : {
		"phpunit/phpunit" : "^11.0"
	},
	"autoload" : {
		"psr-4" : {
			"FreeCap\\" : "src/"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"FreeCap\\Tests\\" : "tests/"
		}
	},
	"config" : {
		"sort-packages" : true
	}
}